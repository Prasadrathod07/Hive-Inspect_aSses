# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Each variable below says whether it belongs in Vercel's project environment
# variables too. Full walkthrough: docs/deployment.md.

# ---------------------------------------------------------------------------
# Supabase — required for the app to do anything real
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
# REQUIRED in Vercel. Public by design (NEXT_PUBLIC_) — it's just an
# endpoint, not a credential.
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. SERVER ONLY — never prefix this with NEXT_PUBLIC_, never
# import it into a client component. Every table has RLS on with no
# policies, so this key is what all server-side reads and writes run as.
# REQUIRED in Vercel. Set it as a server-side (non-public) environment
# variable there — see docs/deployment.md for exactly where.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. NOT CURRENTLY READ by any code path in this app — there is no
# client-side Supabase usage; every read and write goes through a Server
# Action or Route Handler using the service-role client instead. Kept here
# only because it's part of a standard Supabase project's credentials, in
# case a future client-side read path needs it. Do not spend time trying to
# find where it's used — it isn't, yet.
# NOT required in Vercel today.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection string, e.g.
# postgresql://postgres:[password]@[host]:5432/postgres
# Used ONLY for applying migrations from your own machine (`supabase db
# push` or `psql -f <migration>.sql`) — the running app never reads this
# variable.
# DO NOT set this in Vercel. It's a direct database credential the deployed
# app has no use for; setting it there would be pure unnecessary secret
# exposure. Migrations are applied once, from a developer machine, before
# deploying — see docs/deployment.md step 2.
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI Import Auditor — entirely optional
# ---------------------------------------------------------------------------
# The auditor only explains the deterministic integrity report in plain
# language. Leaving this whole section unset (or AI_AUDITOR_ENABLED unset
# /false) is a fully supported configuration: import, editing, duplication,
# persistence, and the integrity report all work exactly the same, and the
# report shows "AI review is unavailable. Your deterministic import
# integrity report is unaffected."
#
# See docs/ai-auditor.md.

# Must be exactly "true" to enable. Anything else (including unset)
# disables it. OPTIONAL in Vercel — omit entirely to ship without AI.
AI_AUDITOR_ENABLED=false

# Required when AI_AUDITOR_ENABLED=true — pick ONE of the two provider
# shapes below. Both are server-only, like the service role key — never
# prefix either with NEXT_PUBLIC_.

# Shape 1: call Anthropic directly.
ANTHROPIC_API_KEY=

# Shape 2: call an OpenAI-compatible endpoint instead (e.g. a self-hosted
# LiteLLM proxy). Both OPENAI_API_KEY and OPENAI_BASE_URL must be set for
# this shape to take effect; if they are, they take priority over
# ANTHROPIC_API_KEY. OPENAI_BASE_URL should point at the proxy's base URL
# (its "/chat/completions" path is appended automatically).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional. Model name passed to whichever provider is configured above.
# Defaults to claude-sonnet-5 for the Anthropic shape, gpt-4o for the
# OpenAI-compatible shape.
AI_AUDITOR_MODEL=

# Optional. Request timeout in milliseconds. Defaults to 20000.
AI_AUDITOR_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Testing — local/CI only, never set in Vercel
# ---------------------------------------------------------------------------

# Set to exactly 1 to opt the two live-database integration tests into
# running (they're skipped by default). Needs SUPABASE_SERVICE_ROLE_KEY
# pointed at a real, migrated database — never point this at production.
# Not read by the app itself, only by `npm test`.
RUN_SUPABASE_INTEGRATION_TESTS=
